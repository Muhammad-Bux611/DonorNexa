# ==============================================================================
# DonorNexa — Environment Variables Template (.env.example)
#
# NOTE: Spring Boot does NOT read .env files natively by default unless
# using an external loader. Set these variables in your shell environment:
#
# Windows (PowerShell):
#   $env:DB_URL="jdbc:mysql://localhost:3306/donornexa_db?useSSL=false&serverTimezone=Asia/Karachi"
#   $env:DB_USERNAME="root"
#   $env:DB_PASSWORD="your_password"
#   $env:SERVER_PORT="8080"
#   $env:UPLOAD_DIR="uploads"
#
# Windows (CMD):
#   set DB_URL=jdbc:mysql://localhost:3306/donornexa_db?useSSL=false&serverTimezone=Asia/Karachi
#   set DB_USERNAME=root
#   set DB_PASSWORD=your_password
#   set SERVER_PORT=8080
#   set UPLOAD_DIR=uploads
#
# Linux / macOS (Bash / Zsh):
#   export DB_URL="jdbc:mysql://localhost:3306/donornexa_db?useSSL=false&serverTimezone=Asia/Karachi"
#   export DB_USERNAME="root"
#   export DB_PASSWORD="your_password"
#   export SERVER_PORT="8080"
#   export UPLOAD_DIR="uploads"
# ==============================================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Settings
DB_URL=jdbc:mysql://localhost:3306/donornexa_db?useSSL=false&serverTimezone=Asia/Karachi&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# JPA / Hibernate Schema Mode (update or validate)
JPA_DDL_AUTO=update

# Upload Storage Directory
UPLOAD_DIR=uploads

# Thymeleaf Template Cache (false for development, true for production)
THYMELEAF_CACHE=false
